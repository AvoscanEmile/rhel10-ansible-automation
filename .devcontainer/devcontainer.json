{
  "containerUser": "root",
  "customizations": {
    "vscode": {
      "extensions": ["redhat.ansible"]
    }
  },
  "image": "ghcr.io/ansible/community-ansible-dev-tools:latest",
  "name": "Ansible",
  "runArgs": [
    "--cap-add=CAP_MKNOD",
    "--cap-add=NET_ADMIN",
    "--cap-add=SYS_ADMIN",
    "--cap-add=SYS_RESOURCE",
    "--device",
    "/dev/fuse",
    "--security-opt",
    "seccomp=unconfined",
    "--security-opt",
    "label=disable",
    "--security-opt",
    "apparmor=unconfined",
    "--security-opt",
    "unmask=/sys/fs/cgroup",
    "--userns=keep-id",
    "--hostname=Ansible",
    "--net=host"
  ],
  "mounts": [
    "source=/srv/git,target=/srv/git,type=bind"
  ],
  "postCreateCommand": "mkdir -p /root/.ssh && echo -e 'Host 192.168.122.*\n\tStrictHostKeyChecking no\n\tUserKnownHostsFile /dev/null\n\tLogLevel ERROR' > /root/.ssh/config && chmod 600 /root/.ssh/config"
}