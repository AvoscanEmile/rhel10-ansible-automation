driftfile /var/lib/chrony/drift
makestep 1.0 3
rtcsync
keyfile /etc/chrony.keys
logdir /var/log/chrony

{% if inventory_hostname == 'alpha' %}
pool 2.rhel.pool.ntp.org iburst
allow 192.168.0.0/16

{% elif inventory_hostname in ['beta', 'gamma', 'delta'] %}
server {{ hostvars['alpha']['ansible_facts']['default_ipv4']['address'] }} iburst

{% elif inventory_hostname == 'epsilon' %}
local stratum 10
{% endif %}